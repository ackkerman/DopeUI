{
  "name": "dope-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "typecheck": "node scripts/build-copyable-sources.mjs && tsc --noEmit && node scripts/check-copyable-types.mjs",
    "test": "vitest run src --no-file-parallelism",
    "lint": "eslint src",
    "format": "prettier --write src index.html tsconfig.json eslint.config.js",
    "format:check": "prettier --check src index.html tsconfig.json eslint.config.js",
    "prebuild": "node scripts/build-copyable-sources.mjs && npx tsx scripts/prepare-frost-colors.ts && node scripts/build-registry.mjs",
    "pretest": "node scripts/build-copyable-sources.mjs && npx tsx scripts/prepare-frost-colors.ts && node scripts/build-registry.mjs",
    "predev": "node scripts/build-copyable-sources.mjs && npx tsx scripts/prepare-frost-colors.ts && node scripts/build-registry.mjs",
    "registry:build": "node scripts/build-copyable-sources.mjs && npx tsx scripts/prepare-frost-colors.ts && node scripts/build-registry.mjs",
    "test:registry": "node --test tests/registry.test.mjs tests/copyable-sources.test.mjs",
    "sources:build": "node scripts/build-copyable-sources.mjs",
    "build:pages": "npm run registry:build && vite build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-slot": "^1.4.0",
    "@vitejs/plugin-react": "5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^0.6.5",
    "flubber": "^0.4.2",
    "glimm": "^0.3.1",
    "loading-dev": "^0.3.5",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "prismjs": "^1.30.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.10.1",
    "rough-notation": "^0.5.1",
    "svg-dotted-map": "^2.0.1",
    "tailwind-merge": "^3.7.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/flubber": "^0.4.0",
    "@types/node": "^26.6.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.9.10",
    "shadow-plugin": "^2.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
